    "build": "node scripts/build/tasks.mjs build",
    "dev": "node scripts/build/tasks.mjs dev",
    "preview": "node scripts/build/tasks.mjs preview",
    "probe": "node scripts/probe/main.mjs",
    "format": "prettier --write src scripts tests package.json vite.config.ts vitest.config.ts playwright.config.ts svelte.config.js tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
