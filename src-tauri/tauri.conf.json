{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Status",
  "identifier": "io.codexstatus.desktop",
  "build": {
    "frontendDist": "../build/web",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Status",
        "width": 300,
        "height": 160,
        "minWidth": 240,
        "minHeight": 40,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/assets/sounds/ding.mp3": "sounds/ding.mp3",
      "../src/assets/sounds/quota-alert.mp3": "sounds/quota-alert.mp3",
      "../src/assets/sounds/quota-low-battery.mp3": "sounds/quota-low-battery.mp3"
    }
  }
}
